# Copy to .env (which git ignores) and fill in. Go doesn't read .env by itself, so load it first:
#   set -a; . ./.env; set +a; go run ./cmd/dndserver

# The Discord bot that sends login codes. Keep the real token out of git.
DISCORD_BOT_TOKEN=your-bot-token-here

# Discord user ids allowed to use the bot's /allow-signin, /remove-signin and /rename-signin commands, comma separated.
# Empty turns them off.
DND_DISCORD_ADMIN_IDS=

# Where the SQLite database lives. It is created if needed.
DND_DB_PATH=data/dnd.db

# Address to listen on.
DND_LISTEN_ADDR=:8080

# Origins allowed to call the API from a browser, comma separated. Empty disables CORS.
DND_CORS_ORIGINS=http://localhost:8081

# Set to 1 to write login codes to the server log instead of sending DMs, when there is no bot
# token above. For local development only.
DND_DEV_MODE=0

# Only if every request comes through a proxy that sets this header (for example X-Forwarded-For).
# Clients can forge it otherwise, so leave it empty when the server is reached directly.
DND_TRUSTED_PROXY_HEADER=
